# Конфигурация MCP-прокси сервера

# Настройки подключения к 1С (обязательные при AUTH_MODE=none)
MCP_ONEC_URL=http://localhost/your_base_name
MCP_ONEC_USERNAME=your_username
MCP_ONEC_PASSWORD=your_password

# Настройки HTTP-сервиса 1С (опциональные)
MCP_ONEC_SERVICE_ROOT=mcp
# Таймаут запросов к 1С в миллисекундах (по умолчанию 120000 = 2 минуты)
# MCP_ONEC_TIMEOUT=120000

# Настройки HTTP-сервера (опциональные)
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Настройки MCP-сервера (опциональные)
MCP_SERVER_NAME=IT-MCP
MCP_SERVER_VERSION=1.0.0

# TTL HTTP-сессии /mcp без активности (мс), по умолчанию 24 часа.
# Сессия с открытым SSE-стримом считается активной и не вычищается.
# На неизвестную/истёкшую сессию сервер отвечает 404 (спецификация MCP),
# и клиент прозрачно создаёт новую сессию.
# MCP_SESSION_TTL_MS=86400000

# Максимум одновременных HTTP-сессий /mcp; при превышении вытесняется
# самая старая неактивная (защита памяти от initialize-штормов)
# MCP_MAX_SESSIONS=1000

# Белый каталог для инструмента save_file: файлы пишутся только внутрь
# него. В HTTP-режиме без настройки используется служебный каталог во
# временной директории; в stdio-режиме без настройки ограничений нет.
# MCP_SAVE_FILE_DIR=./data/files

# Настройки логирования (опциональные)
MCP_LOG_LEVEL=INFO

# Настройки CORS (опциональные)
# MCP_CORS_ORIGINS=["http://localhost:3000", "https://yourdomain.com"]

# Белый список Host-заголовков (без порта) — защита от DNS rebinding.
# Рекомендуется для локальных запусков с MCP_AUTH_MODE=none.
# Пусто — проверка отключена.
# MCP_ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Настройки авторизации OAuth2 (опциональные)
# Режим авторизации: none (по умолчанию) или oauth2
MCP_AUTH_MODE=none

# При AUTH_MODE=oauth2 значения MCP_ONEC_USERNAME/MCP_ONEC_PASSWORD игнорируются

# Публичный URL прокси для OAuth2 (обязательно при AUTH_MODE=oauth2)
# MCP_PUBLIC_URL=https://your-mcp-proxy.example.com

# TTL (время жизни) для OAuth2 токенов в секундах (опциональные)
MCP_OAUTH2_CODE_TTL=120
MCP_OAUTH2_ACCESS_TTL=3600
MCP_OAUTH2_REFRESH_TTL=1209600

# Путь к файлу-снапшоту OAuth2 токенов. Если задан — токены переживут
# перезапуск процесса (docker compose restart, краш). Если не задан —
# хранятся только в памяти и теряются при рестарте.
MCP_OAUTH2_STORE_PATH=./data/oauth2.json

# Окно идемпотентности при ротации refresh-токена (мс).
# Повторное использование одного refresh_token в этом окне возвращает
# ранее выпущенные токены (защита от race condition при параллельных
# refresh-запросах). По истечении окна — отзыв всей цепочки.
MCP_OAUTH2_REFRESH_GRACE_MS=60000

# Защита от перебора паролей на /authorize и /token (при AUTH_MODE=oauth2).
# Число неудачных попыток входа (по IP и по логину) до временной блокировки.
# 0 — отключить защиту (не рекомендуется).
# MCP_AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
# Окно накопления неудачных попыток (мс), по умолчанию 15 минут
# MCP_AUTH_RATE_LIMIT_WINDOW_MS=900000
# Базовая длительность блокировки (мс); каждая следующая серия неудач
# удваивает её (экспоненциальный backoff, потолок — 1 час)
# MCP_AUTH_RATE_LIMIT_BLOCK_MS=60000
# Учитывать IP клиента при подсчёте неудач. Выключайте (false) только там,
# где все клиенты видны с одного адреса (Docker Desktop, прокси без
# X-Forwarded-For) — тогда останется блокировка только по логину.
# MCP_AUTH_RATE_LIMIT_BY_IP=true

# Настройка express "trust proxy" — ОБЯЗАТЕЛЬНА, если прокси стоит за
# reverse proxy (nginx, traefik): иначе блокировка по IP будет видеть
# только адрес прокси. Значения: true, число хопов или "loopback".
# MCP_TRUST_PROXY=1
